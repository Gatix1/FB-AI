# Google Custom Search API (for dynamic information retrieval)
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_api_key_here

# Get your Search Engine ID from: https://programmablesearchengine.google.com/
SEARCH_ENGINE_ID=your_search_engine_id_here

# Groq API (for LLM features)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
